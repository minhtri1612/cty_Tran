# ---- Local development (npm run dev / npm test) ----
# SQLite file; relative paths resolve from the project root.
SCM_DB_PATH=data/hoang-nhat.sqlite3

# ---- Docker Compose (read by docker compose for variable substitution) ----
# Public domain for HTTPS (DNS A/AAAA record must point at the server).
# SCM_DOMAIN=kho.example.com
# Host directory holding the SQLite database (EBS-backed on EC2), owned by uid 1000.
# SCM_DATA_DIR=/srv/hoang-nhat/data
# File with secrets for the app container (SETUP_TOKEN); see deploy/app.env.example.
# SCM_APP_ENV=/srv/hoang-nhat/app.env
# Image tag to run (set to the git commit for rollbacks).
# SCM_IMAGE_TAG=latest
