{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadBackups",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET/hourly/*",
        "arn:aws:s3:::REPLACE_BUCKET/daily/*"
      ]
    },
    {
      "Sid": "ReadBackupsForRestore",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/*"
    },
    {
      "Sid": "ListBackupsForRestore",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET"
    }
  ]
}
